<Project Sdk="Nice3point.Revit.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R27'))">net10.0-windows10.0.19041.0</TargetFramework>
    <Configurations>Debug.R25;Debug.R26;Debug.R27</Configurations>
    <Configurations>$(Configurations);Release.R25;Release.R26;Release.R27</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../commandset/RevitMCPCommandSet.csproj" AdditionalProperties="Configuration=$(Configuration.Replace('.', ' '))" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.TUnit.Revit" Version="$(RevitVersion).*" />
  </ItemGroup>
</Project>
