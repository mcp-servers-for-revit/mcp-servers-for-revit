{
    "name": "mcp-server-for-revit",
    "version": "1.0.0",
    "description": "MCP server for interacting with Autodesk Revit through AI assistants like Claude",
    "main": "./build/index.js",
    "type": "module",
    "bin": {
        "mcp-server-for-revit": "./build/index.js"
    },
    "scripts": {
        "clean": "rimraf build",
        "prebuild": "npm run clean",
        "build": "node esbuild.config.mjs && node generate-tool-schemas.mjs",
        "build:check": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "deploy:addins": "node deploy-addins.mjs",
        "test:smoke": "node test/smoke.mjs"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mcp-servers-for-revit/mcp-servers-for-revit.git"
    },
    "keywords": [
        "mcp",
        "revit",
        "autodesk",
        "claude",
        "ai",
        "bim",
        "architecture"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/mcp-servers-for-revit/mcp-servers-for-revit/issues"
    },
    "homepage": "https://github.com/mcp-servers-for-revit/mcp-servers-for-revit#readme",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.7.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "esbuild": "^0.28.0",
        "rimraf": "^5.0.10",
        "typescript": "^5.8.2"
    },
    "optionalDependencies": {
        "better-sqlite3": "^12.8.0"
    }
}
